# Modelo do .env da raiz — copie para .env e preencha. O .env NUNCA é versionado.
#
# ---------------------------------------------------------------------------
# Chaves de API dos casos que coletam de fontes públicas
# ---------------------------------------------------------------------------

# Rotulador LLM do caso vacinas (eixo B). Nome dedicado de propósito: uma
# ANTHROPIC_API_KEY solta seria capturada por outras ferramentas.
# Todo gasto passa pelo teto rígido de casos/vacinas/core/orcamento.py.
ANTHROPIC_VACINAS_API_KEY=

# Caso youtube-agecovp — YouTube Data API v3 (chave em 5 min, sem verificação).
# Cota de 10.000 unidades/dia; livro-caixa em
# casos/youtube-agecovp/data/cota_youtube.json.
YOUTUBE_API_KEY=

# Caso tiktok — TikTok Research API. A credencial do eTC está revogada desde
# algum ponto entre jun/2025 e ago/2026 (devolve invalid_client).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Caso heine-xande — URL do CSV/dump de Twitter no SharePoint do BioBD PUC-Rio.
# Caso encerrado por escolha em 21/ago/2026 (dependia de envio externo).
URL_XANDE_DADOS=

# ---------------------------------------------------------------------------
# VPN Cloud-DI PUC-Rio — subir o túnel exige elevação (ver CLAUDE.md §4).
# Teste certo: o adaptador OpenVPN TAP-Windows6 em `Up` E rota 10.x existindo —
# o ícone do openvpn-gui na bandeja engana.
# ---------------------------------------------------------------------------
OPENVPN_USERNAME=
OPENVPN_PASSWORD=
OPENVPN_P12_PASSWORD=
VPN_PROXY=

# ---------------------------------------------------------------------------
# Acesso às VMs da Cloud-DI
#   vm031 10.50.0.32 (Mongo: xande_search, reddit; coletor TikTok do eTC)
#   vm037 10.50.0.38 (servidor de disciplinas)
#   vm067 10.50.0.68 (Postgres eTC_Producao: ituassu_2014)
# ---------------------------------------------------------------------------
SSH_USERNAME=
VM_031_PASSWORD=
VM_037_PASSWORD=
VM_067_PASSWORD=

# ---------------------------------------------------------------------------
# Postgres eTC_Producao
# ---------------------------------------------------------------------------
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ---------------------------------------------------------------------------
# Diversos (herdados das cópias antigas; nenhum caso atual usa)
# ---------------------------------------------------------------------------
SENHA_EMAIL_ALUNO=
EMAIL_IMPRESSORA=
