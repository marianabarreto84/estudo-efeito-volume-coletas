# Modelo do .env do caso — copie para .env e preencha. O .env NUNCA é versionado.
# Requer a VPN da Cloud-DI conectada (ver CLAUDE.md §4).

# --- SSH (usuario cloud-di nas VMs da Cloud-DI PUC-Rio) ---
# vm031 = 10.50.0.32 | vm037 = 10.50.0.38 | vm067 = 10.50.0.68
SSH_USERNAME=
VM_031_PASSWORD=
VM_037_PASSWORD=
VM_067_PASSWORD=

# --- VPN Cloud-DI (OpenVPN) ---
OPENVPN_USERNAME=
OPENVPN_PASSWORD=
OPENVPN_P12_PASSWORD=

# --- PostgreSQL (acessado via tunel SSH) ---
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
