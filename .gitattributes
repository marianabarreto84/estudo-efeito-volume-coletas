# Normaliza fim de linha: LF no repositório, nativo no working tree
* text=auto

# Binários — nunca normalizar
*.pdf   binary
*.png   binary
*.xlsx  binary
*.sqlite binary
*.parquet binary
*.p12   binary

# LaTeX/BibTeX contam como texto
*.tex   text
*.bib   text
*.cls   text
*.sty   text
*.bst   text
